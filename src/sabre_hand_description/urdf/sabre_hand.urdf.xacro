<?xml version="1.0"?>
<!--
  SABRE Gazebo integration.

  The Allegro Hand geometry included below is adapted from PAL Robotics S.L.
  under Apache-2.0. See third_party/allegro_hand/NOTICE and LICENSE.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sabre_hand">
  <xacro:arg name="controller_config" default=""/>
  <xacro:arg name="use_sim_time" default="true"/>
  <xacro:property name="deg_to_rad" value="${pi / 180.0}"/>

  <xacro:include filename="allegro/allegro_hand.urdf.xacro"/>

  <link name="world"/>

  <!-- Right-handed Allegro model: three fingers and an opposable thumb. -->
  <xacro:allegro_hand name="sabre" parent="world" reflect="1">
    <origin xyz="0 0 0.27" rpy="0 0 0"/>
  </xacro:allegro_hand>

  <ros2_control name="SABREGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <xacro:macro name="controlled_joint" params="joint initial:=0.0">
      <joint name="${joint}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:controlled_joint joint="sabre_finger_1_rotatory_joint"/>
    <xacro:controlled_joint joint="sabre_finger_1_flexor_1_joint"/>
    <xacro:controlled_joint joint="sabre_finger_1_flexor_2_joint"/>
    <xacro:controlled_joint joint="sabre_finger_1_flexor_3_joint"/>
    <xacro:controlled_joint joint="sabre_finger_2_rotatory_joint"/>
    <xacro:controlled_joint joint="sabre_finger_2_flexor_1_joint"/>
    <xacro:controlled_joint joint="sabre_finger_2_flexor_2_joint"/>
    <xacro:controlled_joint joint="sabre_finger_2_flexor_3_joint"/>
    <xacro:controlled_joint joint="sabre_finger_3_rotatory_joint"/>
    <xacro:controlled_joint joint="sabre_finger_3_flexor_1_joint"/>
    <xacro:controlled_joint joint="sabre_finger_3_flexor_2_joint"/>
    <xacro:controlled_joint joint="sabre_finger_3_flexor_3_joint"/>
    <xacro:controlled_joint joint="sabre_thumb_rotatory_joint" initial="0.5"/>
    <xacro:controlled_joint joint="sabre_thumb_flexor_1_joint"/>
    <xacro:controlled_joint joint="sabre_thumb_flexor_2_joint"/>
    <xacro:controlled_joint joint="sabre_thumb_flexor_3_joint"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controller_config)</parameters>
    </plugin>
  </gazebo>
</robot>
