<?xml version="1.0"?>
<package format="3">
  <name>sabre_hand_bringup</name>
  <version>0.1.0</version>
  <description>Launch and ros2_control configuration for the SABRE hand simulator.</description>
  <maintainer email="maintainer@example.com">SABRE Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>sabre_hand_control</exec_depend>
  <exec_depend>sabre_hand_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
